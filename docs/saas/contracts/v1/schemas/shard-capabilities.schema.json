{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.automata.example/cloud-core/v1/shard-capabilities.schema.json",
  "title": "Automata Core shard capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "shard_id",
    "release",
    "protocols",
    "public_endpoints",
    "server_time_ms"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/definitions/protocolVersion"
    },
    "shard_id": {
      "$ref": "common.schema.json#/definitions/shardId"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$"
        },
        "commit": {
          "type": "string",
          "minLength": 40,
          "maxLength": 64,
          "pattern": "^[0-9a-f]+$"
        }
      }
    },
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegated_actor",
        "core_http",
        "live_log",
        "usage_event",
        "entitlement"
      ],
      "properties": {
        "delegated_actor": { "$ref": "#/definitions/versionSet" },
        "core_http": { "$ref": "#/definitions/versionSet" },
        "page_model": { "$ref": "#/definitions/versionSet" },
        "live_log": { "$ref": "#/definitions/versionSet" },
        "usage_event": { "$ref": "#/definitions/versionSet" },
        "entitlement": { "$ref": "#/definitions/versionSet" }
      }
    },
    "public_endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live_logs_origin"],
      "properties": {
        "live_logs_origin": {
          "$ref": "common.schema.json#/definitions/absoluteHttpsUri"
        }
      }
    },
    "server_time_ms": {
      "$ref": "common.schema.json#/definitions/unixMillis"
    }
  },
  "definitions": {
    "versionSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 255
      }
    }
  }
}
