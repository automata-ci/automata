{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.automata.example/cloud-core/v1/entitlement-snapshot.schema.json",
  "title": "Automata managed-execution entitlement snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "workspace_id",
    "revision",
    "issued_at_ms",
    "effective_at_ms",
    "expires_at_ms",
    "managed_execution"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/definitions/protocolVersion"
    },
    "workspace_id": {
      "$ref": "common.schema.json#/definitions/workspaceId"
    },
    "revision": {
      "$ref": "common.schema.json#/definitions/positiveRevision"
    },
    "issued_at_ms": {
      "$ref": "common.schema.json#/definitions/unixMillis"
    },
    "effective_at_ms": {
      "$ref": "common.schema.json#/definitions/unixMillis"
    },
    "expires_at_ms": {
      "$ref": "common.schema.json#/definitions/unixMillis"
    },
    "managed_execution": {
      "oneOf": [
        { "$ref": "#/definitions/enabled" },
        { "$ref": "#/definitions/disabled" }
      ]
    }
  },
  "definitions": {
    "allowance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowance_id",
        "total_seconds",
        "starts_at_ms",
        "ends_at_ms",
        "exhaustion_behavior"
      ],
      "properties": {
        "allowance_id": {
          "$ref": "common.schema.json#/definitions/canonicalUuid"
        },
        "total_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 315360000
        },
        "starts_at_ms": {
          "$ref": "common.schema.json#/definitions/unixMillis"
        },
        "ends_at_ms": {
          "$ref": "common.schema.json#/definitions/unixMillis"
        },
        "exhaustion_behavior": {
          "type": "string",
          "enum": ["block_new"]
        }
      }
    },
    "enabled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "allowed_profiles",
        "max_concurrency",
        "max_job_seconds"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["enabled"]
        },
        "allowed_profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/definitions/environmentProfile"
          }
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_job_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "compute_allowance": {
          "$ref": "#/definitions/allowance"
        }
      }
    },
    "disabled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "denial_reason"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["disabled"]
        },
        "denial_reason": {
          "type": "string",
          "enum": ["quota", "suspended", "policy", "closed"]
        }
      }
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "workspace_id", "revision", "result"],
      "properties": {
        "protocol_version": {
          "$ref": "common.schema.json#/definitions/protocolVersion"
        },
        "workspace_id": {
          "$ref": "common.schema.json#/definitions/workspaceId"
        },
        "revision": {
          "$ref": "common.schema.json#/definitions/positiveRevision"
        },
        "result": {
          "type": "string",
          "enum": ["applied", "existing"]
        }
      }
    }
  }
}
