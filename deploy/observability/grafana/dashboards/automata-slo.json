{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "yellow", "value": 0.999}, {"color": "green", "value": 0.9999}]}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}, "id": 1,
      "options": {"orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [{"expr": "1 - job:automata_ci_platform_error_ratio:rate5m{cluster=~\"$cluster\",environment=~\"$environment\"}", "refId": "A"}],
      "title": "Platform availability (5m)", "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 1}, {"color": "red", "value": 6}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}, "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "job:automata_ci_platform_error_ratio:rate5m{cluster=~\"$cluster\",environment=~\"$environment\"} / 0.001", "refId": "A"}],
      "title": "Error-budget burn rate (5m)", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 60}, {"color": "red", "value": 300}]}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0}, "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "cluster:automata_ci_control_plane_lease_queue_wait_seconds:p99_5m{cluster=~\"$cluster\",environment=~\"$environment\"}", "refId": "A"}],
      "title": "Queue-to-claim p99", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0}, "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "count(ALERTS{alertstate=\"firing\",alertname=~\"Automata.*\"})", "refId": "A"}],
      "title": "Firing Automata alerts", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}, "id": 5,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "job:automata_ci_platform_error_ratio:rate5m{cluster=~\"$cluster\",environment=~\"$environment\"}", "legendFormat": "5m {{job}}", "refId": "A"},
        {"expr": "job:automata_ci_platform_error_ratio:rate1h{cluster=~\"$cluster\",environment=~\"$environment\"}", "legendFormat": "1h {{job}}", "refId": "B"}
      ],
      "title": "Platform error ratio", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 5, "lineWidth": 2}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}, "id": 6,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, route) (rate(automata_ci_control_plane_http_request_duration_seconds_bucket{cluster=~\"$cluster\",environment=~\"$environment\"}[5m])))", "legendFormat": "p95 {{route}}", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le, route) (rate(automata_ci_control_plane_http_request_duration_seconds_bucket{cluster=~\"$cluster\",environment=~\"$environment\"}[5m])))", "legendFormat": "p99 {{route}}", "refId": "B"}
      ],
      "title": "User-facing latency", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}, "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(automata_ci_control_plane_lease_queue_wait_seconds_bucket{cluster=~\"$cluster\",environment=~\"$environment\"}[5m])))", "legendFormat": "p99", "refId": "A"}],
      "title": "Eligible queue-to-claim latency", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}, "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum(up{job=\"automata-control-plane\",cluster=~\"$cluster\",environment=~\"$environment\"} == 0)", "legendFormat": "control down", "refId": "A"},
        {"expr": "sum(up{job=\"automata-runner\",cluster=~\"$cluster\",environment=~\"$environment\"} == 0)", "legendFormat": "runner down", "refId": "B"},
        {"expr": "sum(automata_ci_runner_session_connected{cluster=~\"$cluster\",environment=~\"$environment\"} == 0)", "legendFormat": "sessions disconnected", "refId": "C"},
        {"expr": "count(automata_ci_runner_inventory_expected{job=\"automata-runner\",cluster=~\"$cluster\",environment=~\"$environment\"} == 1 unless on (job, instance, cluster, environment) up{job=\"automata-runner\",cluster=~\"$cluster\",environment=~\"$environment\"}) or vector(0)", "legendFormat": "inventory missing", "refId": "D"}
      ],
      "title": "Unavailable targets and sessions", "type": "timeseries"
    }
  ],
  "refresh": "30s", "schemaVersion": 39, "tags": ["automata", "slo"],
  "templating": {"list": [
    {"current": {}, "label": "Prometheus", "name": "DS_PROMETHEUS", "options": [], "query": "prometheus", "refresh": 1, "type": "datasource"},
    {"allValue": ".*", "current": {}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "includeAll": true, "label": "Cluster", "name": "cluster", "options": [], "query": {"query": "label_values(automata_ci_build_info, cluster)", "refId": "StandardVariableQuery"}, "refresh": 1, "type": "query"},
    {"allValue": ".*", "current": {}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "includeAll": true, "label": "Environment", "name": "environment", "options": [], "query": {"query": "label_values(automata_ci_build_info, environment)", "refId": "StandardVariableQuery"}, "refresh": 1, "type": "query"}
  ]},
  "time": {"from": "now-24h", "to": "now"}, "timezone": "browser",
  "title": "Automata / SLO and error budget", "uid": "automata-slo", "version": 2
}
