[Unit]
Description=Transient Podman runtime for Automata runner 1
Before=automata-runner@1.service
PartOf=automata-runner-host.target

[Mount]
What=automata-runner-runtime-1
Where=/run/automata-runner-1
Type=tmpfs
Options=nodev,nosuid,noswap,size=20G,nr_inodes=349525,mode=0700,uid=1001,gid=1001

[Install]
WantedBy=automata-runner-host.target
