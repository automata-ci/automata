[Unit]
Description=Automata CI runner instance %i
Documentation=https://github.com/automata-ci/automata/blob/main/deploy/runner-host/README.md
RequiresMountsFor=/run/automata_runner_%i
After=network-online.target
Wants=network-online.target
PartOf=automata-runner-host.target

[Service]
Type=simple
User=automata-runner-%i
Group=automata-runner-%i
Slice=automata-runner-host.slice
WorkingDirectory=/var/lib/automata-runner/%i/home
EnvironmentFile=/etc/automata-runner/instances/%i/environment
ExecStart=/usr/bin/automata-runner run --config /etc/automata-runner/instances/%i/runner.json
Restart=on-failure
RestartSec=5s
UMask=0077
Delegate=yes
DelegateSubgroup=supervisor
CPUQuota=450%
MemoryAccounting=yes
MemoryHigh=17G
MemoryMax=18G
MemorySwapMax=0
TasksAccounting=yes
TasksMax=4608
LimitNOFILE=1048576
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictRealtime=yes

[Install]
WantedBy=automata-runner-host.target
