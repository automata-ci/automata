[Unit]
Description=Transient Podman runtime for Automata runner 3
Before=automata-runner@3.service
PartOf=automata-runner-host.target

[Mount]
What=automata-runner-runtime-3
Where=/run/automata_runner_3
Type=tmpfs
Options=nodev,nosuid,noswap,size=20G,nr_inodes=349525,mode=0700,uid=1003,gid=1003

[Install]
WantedBy=automata-runner-host.target
