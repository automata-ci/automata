{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:automata:cloud-core:v1:delegated-actor-claims",
  "title": "Automata delegated actor JWT claims v1",
  "description": "Claims validated only after ES256 signature and protected-header verification. Roles and permissions are deliberately absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ver",
    "iss",
    "sub",
    "aud",
    "workspace_id",
    "session_id",
    "auth_time",
    "iat",
    "exp",
    "jti"
  ],
  "properties": {
    "ver": {
      "const": 1
    },
    "iss": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "minLength": 9,
      "maxLength": 2048
    },
    "sub": {
      "$ref": "#/$defs/canonicalUuid"
    },
    "aud": {
      "$ref": "#/$defs/shardId"
    },
    "workspace_id": {
      "$ref": "#/$defs/canonicalUuid"
    },
    "session_id": {
      "$ref": "#/$defs/canonicalUuid"
    },
    "auth_time": {
      "$ref": "#/$defs/numericDate"
    },
    "iat": {
      "$ref": "#/$defs/numericDate"
    },
    "exp": {
      "$ref": "#/$defs/numericDate"
    },
    "jti": {
      "$ref": "#/$defs/canonicalUuid"
    }
  },
  "$defs": {
    "canonicalUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "numericDate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "shardId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    }
  }
}
