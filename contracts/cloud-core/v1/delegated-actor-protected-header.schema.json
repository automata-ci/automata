{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:automata:cloud-core:v1:delegated-actor-protected-header",
  "title": "Automata delegated actor JWS protected header v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["typ", "alg", "kid"],
  "properties": {
    "typ": {
      "const": "at+jwt"
    },
    "alg": {
      "const": "ES256"
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._~-]+$"
    }
  }
}
