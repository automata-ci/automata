# syntax=docker/dockerfile:1
ARG RUST_VERSION=1.97.0
FROM --platform=$TARGETPLATFORM rust:${RUST_VERSION}-bookworm AS build

RUN apt-get update \
    && apt-get install --yes --no-install-recommends musl-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .
RUN case "$(uname -m)" in \
        x86_64) rust_target=x86_64-unknown-linux-musl ;; \
        aarch64) rust_target=aarch64-unknown-linux-musl ;; \
        *) exit 1 ;; \
    esac \
    && rustup target add "$rust_target" \
    && cargo build --locked --release \
        --package automata-ci-sandbox-guest \
        --target "$rust_target" \
    && install -D -m 0755 \
        "target/$rust_target/release/automata-ci-sandbox-guest" \
        /out/usr/local/bin/automata-ci-sandbox-guest

FROM scratch
COPY --from=build /out/ /
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/automata-ci-sandbox-guest"]
