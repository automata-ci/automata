name=CI
workflow-env="AUTOMATA_BUILD_GIT_SHA"="${{ github.sha }}","AUTOMATA_EXPECTED_GIT_SHA"="${{ github.sha }}","AUTOMATA_EXPECTED_VERSION"="0.1.0","CARGO_INCREMENTAL"="0","CARGO_TERM_COLOR"="always","RUST_BACKTRACE"="1","TMPDIR"="${{ github.workspace }}/target/task-tmp/ci"
