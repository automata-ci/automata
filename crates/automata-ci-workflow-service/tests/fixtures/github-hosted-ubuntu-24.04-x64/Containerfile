FROM docker.io/library/ubuntu@sha256:678c6550cc43645e08669028bc177f50be4e7c5b8cca677067b1914d4afc7a03

ARG RUSTUP_VERSION=1.29.0
ARG RUSTUP_SHA256=4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10
ARG RUST_TOOLCHAIN=1.97.1
ARG NODE_RUNTIME_VERSION=24.19.0
ARG NODE_RUNTIME_SHA256=14b342e71204f811bde6153be8e04b62aef63c236fef92b55f9c83154b409647
ARG DOCKER_CLI_VERSION=29.6.2
ARG DOCKER_CLI_SHA256=d6204aea92238e2453d5445c885b9d2e5eb8f82915568ec50edf9dbe12a3ac74
ARG CLANG_VERSION=1:18.1.3-1ubuntu1
ARG WASI_SDK_VERSION=24.0
ARG WASI_SDK_SHA256=c6c38aab56e5de88adf6c1ebc9c3ae8da72f88ec2b656fb024eda8d4167a0bc5
ARG WASM_RQUICKJS_CLI_VERSION=0.4.1
ARG CARGO_CYCLONEDX_VERSION=0.5.9
ARG CARGO_DENY_VERSION=0.20.2

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    TMPDIR=/var/lib/automata-transient \
    RUNNER_TOOL_CACHE=/opt/hostedtoolcache \
    AUTOMATA_ENVIRONMENT_PROFILE_ID=automata.dev/github-hosted-ubuntu-24-04-x64-v1 \
    ImageOS=ubuntu24 \
    ImageVersion=automata-ubuntu-24.04-x64-v1 \
    PATH=/opt/automata/externals/node24/bin:/opt/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN set -eux; \
    install -d -m 0700 /var/lib/automata-transient /var/lib/automata-build; \
    install -d -m 0755 /opt/automata/externals/node24 /opt/cargo /opt/rustup /opt/hostedtoolcache /__w; \
    apt-get update; \
    apt-get install --yes --no-install-recommends \
        bash \
        binutils \
        build-essential \
        ca-certificates \
        curl \
        file \
        git \
        gnupg \
        iproute2 \
        clang-18="${CLANG_VERSION}" \
        musl-tools \
        pkg-config \
        procps \
        python3 \
        python3-pip \
        sudo \
        tar \
        unzip \
        util-linux \
        xz-utils \
        zip; \
    test "$(dpkg-query --show --showformat='${Version}' clang-18)" = \
        "${CLANG_VERSION}"; \
    test "$(dpkg-query --show --showformat='${Version}' libclang1-18)" = \
        "${CLANG_VERSION}"; \
    test "$(clang-18 --print-resource-dir)" = /usr/lib/llvm-18/lib/clang/18; \
    test -r /usr/lib/llvm-18/lib/clang/18/include/stddef.h; \
    test -r /usr/lib/x86_64-linux-gnu/libclang-18.so.18; \
    python3 -c \
        'import ctypes; getattr(ctypes.CDLL("libclang-18.so.18"), "clang_getClangVersion")'; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    archive="wasi-sdk-${WASI_SDK_VERSION}-x86_64-linux.tar.gz"; \
    sdk="/opt/wasi-sdk-${WASI_SDK_VERSION}"; \
    curl --fail --location --proto '=https' --proto-redir '=https' --tlsv1.2 \
        --output "/var/lib/automata-build/${archive}" \
        "https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-24/${archive}"; \
    echo "${WASI_SDK_SHA256}  /var/lib/automata-build/${archive}" \
        | sha256sum --check --strict; \
    install -d -m 0755 "${sdk}"; \
    tar --extract --gzip --file "/var/lib/automata-build/${archive}" \
        --directory "${sdk}" --strip-components 1; \
    test -x "${sdk}/bin/clang"; \
    test -x "${sdk}/bin/llvm-ar"; \
    test -r "${sdk}/share/wasi-sysroot/include/wasm32-wasip2/stdio.h"; \
    "${sdk}/bin/clang" \
        --target=wasm32-wasip2 \
        --sysroot="${sdk}/share/wasi-sysroot" \
        -x c -include stdio.h -c /dev/null \
        -o /var/lib/automata-build/wasi-sdk-smoke.o; \
    "${sdk}/bin/llvm-ar" rcs \
        /var/lib/automata-build/wasi-sdk-smoke.a \
        /var/lib/automata-build/wasi-sdk-smoke.o; \
    test "$("${sdk}/bin/llvm-ar" t /var/lib/automata-build/wasi-sdk-smoke.a)" = \
        wasi-sdk-smoke.o; \
    rm -f \
        "/var/lib/automata-build/${archive}" \
        /var/lib/automata-build/wasi-sdk-smoke.a \
        /var/lib/automata-build/wasi-sdk-smoke.o

RUN set -eux; \
    curl --fail --location --proto '=https' --tlsv1.2 \
        --output /var/lib/automata-build/rustup-init \
        "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init"; \
    echo "${RUSTUP_SHA256}  /var/lib/automata-build/rustup-init" | sha256sum --check --strict; \
    chmod 0700 /var/lib/automata-build/rustup-init; \
    /var/lib/automata-build/rustup-init -y --no-modify-path --profile minimal --default-toolchain none; \
    rustup toolchain install "${RUST_TOOLCHAIN}" \
        --profile minimal \
        --component clippy \
        --component rustfmt \
        --target wasm32-wasip2 \
        --target x86_64-unknown-linux-musl; \
    rustup default "${RUST_TOOLCHAIN}"; \
    rm -f /var/lib/automata-build/rustup-init

RUN set -eux; \
    archive="node-v${NODE_RUNTIME_VERSION}-linux-x64.tar.xz"; \
    curl --fail --location --proto '=https' --tlsv1.2 \
        --output "/var/lib/automata-build/${archive}" \
        "https://nodejs.org/download/release/v${NODE_RUNTIME_VERSION}/${archive}"; \
    echo "${NODE_RUNTIME_SHA256}  /var/lib/automata-build/${archive}" | sha256sum --check --strict; \
    tar --extract --xz --file "/var/lib/automata-build/${archive}" \
        --directory /opt/automata/externals/node24 --strip-components 1; \
    rm -f "/var/lib/automata-build/${archive}"; \
    rustc --version --verbose; \
    cargo --version --verbose; \
    node --version; \
    npm --version

RUN set -eux; \
    export CARGO_TARGET_DIR=/var/lib/automata-build/renderer-tools-target; \
    cargo install wasm-rquickjs-cli \
        --version "${WASM_RQUICKJS_CLI_VERSION}" --locked; \
    cargo install cargo-cyclonedx \
        --version "${CARGO_CYCLONEDX_VERSION}" --locked; \
    cargo install cargo-deny \
        --version "${CARGO_DENY_VERSION}" --locked; \
    test "$(wasm-rquickjs --version)" = \
        "wasm-rquickjs-cli ${WASM_RQUICKJS_CLI_VERSION}"; \
    test "$(cargo cyclonedx --version)" = \
        "cargo-cyclonedx-cyclonedx ${CARGO_CYCLONEDX_VERSION}"; \
    test "$(cargo deny --version)" = \
        "cargo-deny ${CARGO_DENY_VERSION}"; \
    rm -rf "${CARGO_TARGET_DIR}"

RUN set -eux; \
    archive="docker-${DOCKER_CLI_VERSION}.tgz"; \
    curl --fail --location --proto '=https' --tlsv1.2 \
        --output "/var/lib/automata-build/${archive}" \
        "https://download.docker.com/linux/static/stable/x86_64/${archive}"; \
    echo "${DOCKER_CLI_SHA256}  /var/lib/automata-build/${archive}" \
        | sha256sum --check --strict; \
    tar --extract --gzip --file "/var/lib/automata-build/${archive}" \
        --directory /var/lib/automata-build docker/docker; \
    install -m 0755 /var/lib/automata-build/docker/docker /usr/local/bin/docker; \
    rm -rf "/var/lib/automata-build/${archive}" /var/lib/automata-build/docker; \
    docker --version

LABEL org.opencontainers.image.title="Automata GitHub-hosted Ubuntu 24.04 x64 compatibility profile" \
      org.opencontainers.image.source="https://github.com/automata-ci/automata" \
      org.opencontainers.image.licenses="MIT" \
      io.automata.environment-profile="automata.dev/github-hosted-ubuntu-24-04-x64-v1"

WORKDIR /__w
USER 0:0
CMD ["/bin/sleep", "infinity"]
